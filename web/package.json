{
  "name": "asc-viewer-web",
  "version": "0.1.0",
  "private": true,
  "description": "LTspice .asc Schematic-Viewer (MVP) — Stencil v4 + TypeScript",
  "scripts": {
    "build-wasm": "wasm-pack build --target web --dev --out-dir web/.wasmtmp && node normalize-wasm.cjs",
    "build": "npm run build-wasm && stencil build && node copy-index.cjs",
    "dev": "npm run build && serve -l 8080 www",
    "serve": "serve -l 8080 www",
    "test": "stencil test --spec"
  },
  "devDependencies": {
    "@stencil/core": "^4.0.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "serve": "^14.2.4",
    "typescript": "^5.5.4"
  }
}
